{
  "name": "immotrack",
  "private": true,
  "description": "ImmoTrack — recherche, historisation et analyse d'investissements immobiliers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@immotrack/web",
    "build": "turbo run build",
    "start": "pnpm --filter @immotrack/web start",
    "lint": "pnpm run lint:code && pnpm run lint:architecture",
    "lint:code": "eslint . --max-warnings=0",
    "lint:architecture": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agent:hash-token": "node scripts/hash-agent-token.mjs",
    "contracts:generate": "pnpm --filter @immotrack/contracts generate:json-schema"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
