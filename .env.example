# ImmoTrack — variables d'environnement.
# Copier vers apps/web/.env.local pour le développement (`cp .env.example apps/web/.env.local`).
# Ne JAMAIS committer de fichier .env contenant des valeurs réelles.
# Toutes ces variables sont lues côté serveur uniquement (aucune n'est préfixée NEXT_PUBLIC_).

# --- Base de données (serveur uniquement) -----------------------------------------------------
# Supabase local (`supabase start`) : postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production (Vercel) : URL du pooler Supabase en mode transaction (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Taille du pool par instance serverless (1 à 20, défaut 3).
DATABASE_POOL_MAX=3

# --- Authentification administrateur (Supabase Auth) -------------------------------------------
# `supabase` (défaut) ou `disabled` (développement local uniquement, refusé en production).
AUTH_MODE=supabase
# URL du projet et clé PUBLIABLE (anon/publishable). Ne jamais utiliser la clé service_role ici.
# Valeurs locales : `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Email de l'unique compte administrateur autorisé (créé dans Supabase Studio).
ADMIN_EMAIL=admin@example.com

# --- Ingestion agent -------------------------------------------------------------------------
# Empreintes SHA-256 (hex) des jetons agents acceptés, séparées par des virgules (rotation).
# Générer avec `pnpm agent:hash-token`. Vide = toute ingestion est refusée (401).
AGENT_INGESTION_TOKEN_SHA256=
# Taille maximale d'un lot en octets (défaut 1 000 000).
AGENT_INGESTION_MAX_BODY_BYTES=1000000

# --- Observabilité ---------------------------------------------------------------------------
# debug | info | warn | error (défaut info).
LOG_LEVEL=info

# --- Tests d'intégration ---------------------------------------------------------------------
# Serveur PostgreSQL sur lequel les tests créent puis suppriment des bases dédiées.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
